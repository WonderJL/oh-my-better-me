  boundary --> tune["Week 4: fine-tuning memo or LoRA dry run"]
  tune --> capstone["Capstone: defensible LLM assistant"]

  subgraph retrieval["RAG core"]
    chunk["Chunking"]
    embed["Embeddings"]
    retrieve["Retrieve and rerank"]
    cite["Citations"]
  end

  subgraph agents["Agent core"]
